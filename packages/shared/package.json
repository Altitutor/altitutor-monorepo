{
  "name": "@altitutor/shared",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./auth/server": {
      "types": "./dist/auth/server/index.d.ts",
      "default": "./dist/auth/server/index.js"
    },
    "./interviews/server": {
      "types": "./dist/interviews/server/index.d.ts",
      "default": "./dist/interviews/server/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pay-tiers": {
      "types": "./dist/pay-tiers/index.d.ts",
      "default": "./dist/pay-tiers/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.37",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "@testing-library/dom": "^10.4.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altitutor/altitutor-monorepo.git",
    "directory": "packages/shared"
  },
  "dependencies": {
    "@altitutor/ucat-response-contract": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "date-fns": "^4.1.0"
  }
}
