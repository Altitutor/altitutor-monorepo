# ============================================================
# PRODUCTION ENVIRONMENT SECRETS
# ============================================================
# Copy this file to .env.production and fill in your actual values
# ⚠️  HANDLE WITH EXTREME CARE - THESE ARE PRODUCTION SECRETS ⚠️

# Supabase Development Project
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog (public web apps only: marketing-web, student-web, ucat-web)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI generation
OPENROUTER_API_KEY=
# Shared by admin-web and tutor-web. Generate with: openssl rand -base64 32
UCAT_CODEX_OAUTH_ENCRYPTION_KEY=

# Twilio
TWILIO_VERIFY_SIGNATURE=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Secret key for billing cron job - must be set in vault and edge functions
BILLING_CRON_SECRET_KEY=
# iMessage API
IMESSAGE_API_KEY=
IMESSAGE_WEBHOOK_SECRET=

# Openrouter
OPENROUTER_API_KEY=
UCAT_CODEX_OAUTH_ENCRYPTION_KEY=

# Sentry error monitoring shared build credentials
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

# Per-project Sentry runtime DSNs and project slugs
ADMIN_WEB_SENTRY_DSN=
ADMIN_WEB_SENTRY_PROJECT=
MARKETING_WEB_SENTRY_DSN=
MARKETING_WEB_SENTRY_PROJECT=
STUDENT_WEB_SENTRY_DSN=
STUDENT_WEB_SENTRY_PROJECT=
TUTOR_WEB_SENTRY_DSN=
TUTOR_WEB_SENTRY_PROJECT=
UCAT_WEB_SENTRY_DSN=
UCAT_WEB_SENTRY_PROJECT=

# Optional: override student web URL for mobile app (defaults to production URL)
# NEXT_PUBLIC_STUDENT_URL=https://student.altitutor.com
