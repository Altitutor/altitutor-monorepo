{
  "name": "marketing-web",
  "version": "0.1.0",
  "description": "Altitutor root-domain marketing site",
  "author": "Altitutor",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-email-assets.mjs",
    "dev": "next dev --webpack -p 3003",
    "prebuild": "node scripts/sync-email-assets.mjs",
    "build": "next build --webpack",
    "postbuild": "node ../../scripts/cleanup-ci-next-cache.mjs",
    "start": "next start -p 3003",
    "lint": "eslint . --max-warnings=0",
