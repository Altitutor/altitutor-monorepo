    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@sentry/nextjs": "10.78.0",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^1.65.0",
    "motion": "^12.38.0",
    "next": "^16.4.3",
