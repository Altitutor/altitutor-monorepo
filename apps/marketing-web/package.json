    "@types/jest": "^29.5.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.17.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jest": "^29.7.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
