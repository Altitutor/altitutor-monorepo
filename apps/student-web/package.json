{
  "name": "student-web",
  "version": "0.1.0",
  "description": "Altitutor student-facing web app",
  "author": "Vibe coder",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "dev:local": "cp .env.local.backup .env.local 2>/dev/null || cp .env.local .env.local.backup && next dev --webpack -p 3001",
    "dev:remote": "cp .env.local .env.local.backup 2>/dev/null && cp .env.remote .env.local && next dev --webpack -p 3001",
    "switch:local": "node ../../scripts/switch-env.js local",
    "switch:remote": "node ../../scripts/switch-env.js remote",
    "build": "next build --webpack",
    "postbuild": "node ../../scripts/cleanup-ci-next-cache.mjs",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "type-check": "npm run typecheck",
    "db:types": "pnpm --filter @altitutor/shared run build",
    "db:types:remote": "pnpm --filter @altitutor/shared run build"
  },
  "dependencies": {
    "@altitutor/email": "workspace:*",
    "@altitutor/shared": "workspace:*",
    "@altitutor/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@open-spaced-repetition/binding": "0.5.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "10.78.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/functions": "^3.7.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "datebook": "^8.0.1",
    "dotenv": "^16.5.0",
    "gsap": "^3.14.2",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.65.0",
    "motion": "^12.38.0",
    "next": "^16.4.3",
    "next-themes": "^0.2.1",
    "nextstepjs": "^2.2.0",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "1.402.0",
    "posthog-node": "^5.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-leaflet": "^5.0.0",
    "react-phone-number-input": "^3.4.14",
    "sonner": "^2.0.3",
    "stripe": "^20.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.4.1",
    "uuid": "^11.1.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@swc/core": "^1.11.21",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.19.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.2.4",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3",
    "vite": "^6.3.2",
    "@testing-library/dom": "^10.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altitutor/altitutor-monorepo.git",
    "directory": "apps/student-web"
  }
}
