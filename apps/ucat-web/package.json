{
  "name": "ucat-web",
  "version": "0.1.0",
  "description": "Altitutor UCAT student-facing web app",
  "author": "Codex",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3004",
    "build": "next build --webpack",
    "postbuild": "node ../../scripts/cleanup-ci-next-cache.mjs",
    "start": "next start -p 3004",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:critical": "playwright test --grep @critical --project=desktop-chromium",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@altitutor/email": "workspace:*",
    "@altitutor/shared": "workspace:*",
    "@altitutor/ucat-marking": "workspace:*",
    "@altitutor/ucat-percentiles": "workspace:*",
    "@altitutor/ucat-response-contract": "workspace:*",
    "@altitutor/ui": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@sentry/nextjs": "^10.78.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@vercel/functions": "^3.7.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.65.0",
    "ml-levenberg-marquardt": "^5.0.1",
    "motion": "^12.38.0",
    "next": "^16.4.3",
    "next-themes": "^0.2.1",
    "nextstepjs": "^2.2.0",
    "posthog-js": "1.402.0",
    "posthog-node": "^5.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@swc/core": "^1.11.21",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "@testing-library/dom": "^10.4.2"
  }
}
