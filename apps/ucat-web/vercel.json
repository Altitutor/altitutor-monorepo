{
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=ucat-web",
  "devCommand": "cd ../.. && pnpm turbo run dev --filter=ucat-web",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "src/app/api/cron/ucat-preparation-refreshes/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/ucat-preparation-refreshes",
      "schedule": "*/5 * * * *"
    }
  ]
}
