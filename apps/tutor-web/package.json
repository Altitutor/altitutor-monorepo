    "@types/react-big-calendar": "^1.16.1",
    "@vercel/queue": "^0.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
