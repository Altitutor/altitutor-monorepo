{
  "name": "tutor-web",
  "version": "0.1.0",
  "description": "Altitutor tutor-facing web app",
  "author": "Vibe coder",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "dev:local": "cp .env.local.backup .env.local 2>/dev/null || cp .env.local .env.local.backup && next dev --webpack -p 3002",
    "dev:remote": "cp .env.local .env.local.backup 2>/dev/null && cp .env.remote .env.local && next dev --webpack -p 3002",
    "switch:local": "node ../../scripts/switch-env.js local",
    "switch:remote": "node ../../scripts/switch-env.js remote",
    "build": "next build --webpack",
    "postbuild": "node ../../scripts/cleanup-ci-next-cache.mjs",
    "start": "next start -p 3002",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "benchmark:ucat-generation": "tsx scripts/benchmark-ucat-generation.ts",
    "benchmark:ucat-render-assets": "tsx scripts/render-ucat-benchmark-assets.ts",
    "audit:ucat-dm-categories": "tsx scripts/audit-ucat-dm-categories.ts",
    "seed:ucat-find-word-wikipedia": "tsx scripts/generate-ucat-find-word-wikipedia-seed.ts",
    "seed:ucat-skill-trainers": "tsx scripts/generate-ucat-skill-trainer-seed.ts",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "type-check": "npm run typecheck",
    "db:types": "pnpm --filter @altitutor/shared run build",
    "db:types:remote": "pnpm --filter @altitutor/shared run build"
  },
  "dependencies": {
    "@altitutor/email": "workspace:*",
    "@altitutor/shared": "workspace:*",
    "@altitutor/ucat-blueprint": "workspace:*",
    "@altitutor/ucat-response-contract": "workspace:*",
    "@altitutor/ucat-percentiles": "workspace:*",
    "@altitutor/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
