NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TUTOR_URL=http://localhost:3002
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENROUTER_API_KEY=
# UCAT authoring image generate/edit/revise.
# Key resolution: UCAT_IMAGE_OPENAI_API_KEY → OPENAI_API_KEY → OPENROUTER_API_KEY.
# With only OPENROUTER_API_KEY set, image tools use OpenRouter's Image API.
# UCAT_IMAGE_OPENAI_API_KEY=
# OPENAI_API_KEY=
# UCAT_IMAGE_MODEL=openai/gpt-image-2
# UCAT_IMAGE_EDIT_MODEL=openai/gpt-image-2
# UCAT_IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
# UCAT_IMAGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Server-side only. Must match admin-web for UCAT Codex OAuth token decryption.
UCAT_CODEX_OAUTH_ENCRYPTION_KEY=
# Server-side emergency kill switch for all UCAT AI review (automatic and manual).
# Unset defaults to enabled only in Vercel production.
# To disable automatic-only review, use admin-web UCAT generation settings instead.
UCAT_AI_AUTOMATIC_REVIEW_ENABLED=false
# Shared with Vercel Cron for durable recovery of queued/deferred assessments.
CRON_SECRET=
