-- Run directly with psql so the migration includes share one session.
BEGIN;
CREATE EXTENSION IF NOT EXISTS pgtap WITH SCHEMA extensions;
SET LOCAL search_path TO public, extensions;
SELECT plan(6);

INSERT INTO public.question_stems (
  id,
  section_id,
  stem_text,
  question_stem_category_id
)
SELECT
  fixture.id,
  section.id,
  jsonb_build_object(
    'type', 'doc',
    'content', jsonb_build_array(jsonb_build_object(
      'type', 'paragraph',
      'content', jsonb_build_array(jsonb_build_object(
        'type', 'text',
        'text', 'ALTI-540 production drift fixture'
      ))
    ))
  ),
  fixture.category_id
FROM (
  VALUES
    (
      '00e845fc-83db-455d-91c8-f3d436563a1c'::UUID,
      '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID
    ),
    (
      '611ad210-c7c7-4093-880a-0ee9870b2daa'::UUID,
      'af97ced6-4266-4926-988b-2cc6cf288e23'::UUID
    ),
    (
      'cfbff7c7-baaf-4856-bc06-4cdd2034306f'::UUID,
      '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID
    )
) AS fixture(id, category_id)
CROSS JOIN public.ucat_sections section
WHERE section.name = 'Decision Making';

\ir ../migrations/20260810142900_prepare_reviewed_dm_category_drift.sql
\ir ../migrations/20260810143000_reclassify_reviewed_decision_making_content.sql
\ir ../migrations/20260810143100_reconcile_reviewed_dm_category_drift.sql

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = '00e845fc-83db-455d-91c8-f3d436563a1c'
  ),
  '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID,
  'the applied ordering puzzle remains Logical Puzzles'
);

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = '611ad210-c7c7-4093-880a-0ee9870b2daa'
  ),
  '24df84c6-47d7-45d3-a255-e32d23c20eef'::UUID,
  'the stock-price graph is reconciled to IIDC'
);

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = 'cfbff7c7-baaf-4856-bc06-4cdd2034306f'
  ),
  '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID,
  'the sibling ordering puzzle remains Logical Puzzles'
);

-- Development has already applied the immutable migration. Recreate that
-- post-ALTI-540 state and prove the newly inserted migrations are idempotent
-- when --include-all applies them later.
UPDATE public.question_stems
SET question_stem_category_id = CASE id
  WHEN '00e845fc-83db-455d-91c8-f3d436563a1c'::UUID
    THEN '24df84c6-47d7-45d3-a255-e32d23c20eef'::UUID
  WHEN '611ad210-c7c7-4093-880a-0ee9870b2daa'::UUID
    THEN '24df84c6-47d7-45d3-a255-e32d23c20eef'::UUID
  WHEN 'cfbff7c7-baaf-4856-bc06-4cdd2034306f'::UUID
    THEN 'b35d193a-d054-4ac2-8ae3-669ac1ff79bc'::UUID
END
WHERE id IN (
  '00e845fc-83db-455d-91c8-f3d436563a1c',
  '611ad210-c7c7-4093-880a-0ee9870b2daa',
  'cfbff7c7-baaf-4856-bc06-4cdd2034306f'
);

\ir ../migrations/20260810142900_prepare_reviewed_dm_category_drift.sql
\ir ../migrations/20260810143100_reconcile_reviewed_dm_category_drift.sql

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = '00e845fc-83db-455d-91c8-f3d436563a1c'
  ),
  '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID,
  'the out-of-order development application restores the first puzzle'
);

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = '611ad210-c7c7-4093-880a-0ee9870b2daa'
  ),
  '24df84c6-47d7-45d3-a255-e32d23c20eef'::UUID,
  'the out-of-order development application preserves IIDC'
);

SELECT is(
  (
    SELECT question_stem_category_id
    FROM public.question_stems
    WHERE id = 'cfbff7c7-baaf-4856-bc06-4cdd2034306f'
  ),
  '1ec3d39d-ae61-4ea6-9cef-bd149a96fd3a'::UUID,
  'the out-of-order development application restores the sibling puzzle'
);

SELECT * FROM finish();
ROLLBACK;
