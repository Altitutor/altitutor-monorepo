{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "14",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package.json",
    "turbo.json",
    "tsconfig.json",
    "eslint.configs.mjs"
  ],
  "globalPassThroughEnv": [
    "CI", "VERCEL_ENV", "VERCEL_TARGET_ENV",
    "SENTRY_*", "NEXT_PUBLIC_SENTRY_*", "EXPO_PUBLIC_SENTRY_*"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/ui#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/ucat-marking#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/shared#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/ucat-percentiles#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/ucat-blueprint#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@altitutor/ucat-response-contract#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ALTITUTOR_CI_BUILD", "VERCEL_ENV", "VERCEL_TARGET_ENV",
        "SENTRY_DISABLED", "SENTRY_TEST_OPT_IN",
        "NEXT_PUBLIC_SENTRY_*", "EXPO_PUBLIC_SENTRY_*"
      ],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": { "dependsOn": ["^build"] },
    "lint:fix": {},
    "test": { "dependsOn": ["^build"] },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
