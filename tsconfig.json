{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@ui/*": ["./packages/ui/src/*"],
      "@altitutor/shared": ["./packages/shared/src/index.ts"],
      "@altitutor/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": [
    "node_modules"
  ]
}


