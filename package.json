{
  "name": "workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo workspace for Altitutor apps and packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev-web": "turbo run dev --filter='./apps/*-web'",
    "dev:isolated": "python3 scripts/worktree_dev.py",
    "build": "turbo run build",
    "lint": "turbo run lint --max-warnings=0",
    "lint:fix": "turbo run lint:fix --max-warnings=0",
    "test": "turbo run test --concurrency=2",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint && turbo run typecheck && pnpm test",
    "checkall": "bash scripts/checkall.sh",
    "db:types": "python3 scripts/owned_database.py types",
    "db:seed:ucat": "bash supabase/scripts/apply-ucat-test-seed.sh",
    "db:email-templates": "pnpm --filter @altitutor/email generate:auth && bash supabase/scripts/render-email-templates.sh",
    "email:check": "pnpm --filter @altitutor/email check:auth",
    "email:preview": "node supabase/scripts/watch-ucat-email-previews.mjs",
    "ucat:email-preview": "pnpm email:preview",
    "db:committypes": "python3 scripts/owned_database.py committypes"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.108.0",
    "turbo": "^2.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "globals": "^17.13.0"
  },
  "packageManager": "pnpm@11.28.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altitutor/altitutor-monorepo.git"
  }
}
